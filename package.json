{
  "name": "mun-chamber",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,live -c blue,red \"next dev\" \"wrangler dev -c worker/wrangler.jsonc\"",
    "dev:web": "next dev",
    "dev:live": "wrangler dev -c worker/wrangler.jsonc",
    "build": "next build",
    "start": "next start",
    "deploy:live": "wrangler deploy -c worker/wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
